# Training output. A single run's replay buffer is ~2.8 GB and the runs
# directory reached 16 GB during development -- none of it belongs in git.
runs/
*.pt
*.npz

# Recorded human laps. ~25 MB per lap, and they are specific to one person's
# driving on one track, so everyone generates their own.
demos/

# Track maps are built from your own recordings in about a minute.
maps/

# Database exports of your own training data (tools/export_db.py and
# tools/load_db.py). Derived entirely from runs/ and demos/ above, so they
# are regenerated in seconds and never belong in git.
dbexport/
*.db
*.sqlite
*.sqlite3

# Coursework that happens to live here. Not part of the project.
docs/proposal.html

# Generated figures and captures -- these are regenerated from your own
# recordings, so they are not worth versioning...
docs/*.png

# ...except the README's images, which have to be in the repo to render on
# GitHub. Regenerate with tools/make_hero.py against one of your own laps.
!docs/hero.png
!docs/hud.png

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
